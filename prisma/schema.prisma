datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model UserSettings {
  id            Int     @id @default(autoincrement())
  telegramId    BigInt  @unique
  morningTime   String  @default("08:00")
  eveningTime   String  @default("20:00")
  notifications Boolean @default(true)
}

model Schedule {
  id        Int     @id @default(autoincrement())
  dayOfWeek String
  time      String
  subject   String
  room      String?
}

model Homework {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  dueDate     DateTime
  priority    String   @default("Звичайний")
  isCompleted Boolean  @default(false)
}

model Goal {
  id          Int      @id @default(autoincrement())
  title       String
  targetDate  DateTime
  progress    Int      @default(0)
  isCompleted Boolean  @default(false)
}

model SkincareItem {
  id           Int    @id @default(autoincrement())
  name         String
  scheduleDays String
  timeSlot     String
}

// Нова модель для функції "У дорогу" (Багаж / Чек-лист поїздки)
model TripItem {
  id          Int     @id @default(autoincrement())
  category    String  // "Техніка", "Одяг", "Документи", "Гроші"
  title       String  // Назва речі
  quantity    Int     @default(1) // Кількість
  isPacked    Boolean @default(false) // Чи складено
}