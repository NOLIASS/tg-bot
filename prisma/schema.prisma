datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model UserSettings {
  id            Int     @id @default(autoincrement())
  telegramId    BigInt  @unique
  morningTime   String  @default("08:00")
  eveningTime   String  @default("20:00")
  notifications Boolean @default(true)
}

model Schedule {
  id        Int     @id @default(autoincrement())
  dayOfWeek String
  time      String
  subject   String
  room      String?
  zoomLink  String?
}

model Homework {
  id          Int      @id @default(autoincrement())
  title       String
  dueDate     DateTime
  priority    String   @default("Звичайний")
  isCompleted Boolean  @default(false)
}

model Goal {
  id          Int      @id @default(autoincrement())
  title       String
  targetDate  DateTime
  progress    Int      @default(0)
  isCompleted Boolean  @default(false)
}

// 1. Модуль поїздок ("У дорогу")
model TripItem {
  id        Int     @id @default(autoincrement())
  category  String  // Техніка, Одяг, Документи
  title     String
  quantity  Int     @default(1)
  isPacked  Boolean @default(false)
}

// 2. "Другий мозок" (Швидкі нотатки / Inbox)
model QuickNote {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
}

// 3. Міні-CRM для замовлень / фрілансу
model Order {
  id          Int    @id @default(autoincrement())
  clientName  String
  niche       String
  amount      Float
  status      String @default("Новий") // Новий, В роботі, Виконано
}

// 4. Тайм-трекер
model TimeLog {
  id          Int       @id @default(autoincrement())
  projectName String
  startTime   DateTime  @default(now())
  endTime     DateTime?
  durationMins Int?
}

// 5. Фінансові підписки / платежі
model Subscription {
  id        Int      @id @default(autoincrement())
  title     String
  amount    Float
  payDate   DateTime
}

// 6. Квізи / Картки для навчання
model Flashcard {
  id       Int    @id @default(autoincrement())
  question String
  answer   String
}