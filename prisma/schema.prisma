datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Schedule {
  id        Int    @id @default(autoincrement())
  dayOfWeek String // наприклад: "Понеділок", "Вівторок"
  time      String // "08:30"
  subject   String // Назва пари
  room      String? // Аудиторія
}

model Homework {
  id          Int      @id @default(autoincrement())
  title       String   // Предмет / завдання
  description String?  // Деталі
  dueDate     DateTime // Дедлайн
  isCompleted Boolean  @default(false)
}

model SkincareItem {
  id          Int      @id @default(autoincrement())
  name        String   // Назва засобу (наприклад, "Азелаїнка")
  scheduleDays String  // Дні тижня через кому (наприклад, "Понеділок,Четвер" або "Щодня")
  timeSlot    String   // Час (наприклад, "Зранку і ввечері" або "20:00")
}